<view class="container"><view class="filter-bar"><view data-event-opts="{{[['tap',[['setType',['all']]]]]}}" class="{{['filter-item',filterType==='all'?'active':'']}}" bindtap="__e">全部</view><view data-event-opts="{{[['tap',[['setType',['inbound']]]]]}}" class="{{['filter-item',filterType==='inbound'?'active':'']}}" bindtap="__e">入库</view><view data-event-opts="{{[['tap',[['setType',['outbound']]]]]}}" class="{{['filter-item',filterType==='outbound'?'active':'']}}" bindtap="__e">出库</view></view><block wx:if="{{loading}}"><view class="loading-area"><text class="text-secondary">加载中...</text></view></block><block wx:else><block wx:if="{{$root.g0===0}}"><view class="empty-area"><text class="text-secondary">暂无操作记录</text></view></block><block wx:else><view><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="idx" wx:key="idx"><view class="card record-card"><view class="flex-between"><view class="{{['record-type-tag',item.$orig.type==='inbound'?'tag-blue':'tag-green']}}">{{item.$orig.type==='inbound'?'入库':'出库'}}</view><text class="record-time">{{item.m0}}</text></view><view class="record-detail"><text class="record-barcode">{{item.$orig.barcode}}</text><text class="record-info">{{(item.$orig.articleNo||item.$orig.item_code)+" / "+item.$orig.size+"码 x "+item.$orig.quantity}}</text></view><view class="record-footer"><text class="record-operator">{{"操作人: "+item.$orig.operator}}</text><block wx:if="{{item.$orig.remark}}"><text class="record-remark">{{item.$orig.remark}}</text></block></view></view></block><block wx:if="{{hasMore&&!loading}}"><view data-event-opts="{{[['tap',[['loadMore',['$event']]]]]}}" class="load-more" bindtap="__e"><text class="text-secondary">加载更多</text></view></block></view></block></block></view>