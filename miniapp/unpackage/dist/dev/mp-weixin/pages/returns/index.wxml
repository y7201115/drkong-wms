<view class="container"><view class="card"><view class="scan-area"><button data-event-opts="{{[['tap',[['handleScan',['$event']]]]]}}" class="btn-primary scan-btn btn-yellow" bindtap="__e">📷 扫码登记退件</button></view><block wx:if="{{expressNo}}"><view class="form-section"><view class="form-item"><text class="form-label">快递单号</text><text class="form-value mono">{{expressNo}}</text></view><block wx:if="{{expressCompany}}"><view class="form-item"><text class="form-label">快递公司</text><text class="form-value">{{expressCompany}}</text></view></block><view class="form-item"><text class="form-label">退件货号</text><input class="form-input" placeholder="扫码或手动输入" data-event-opts="{{[['input',[['__set_model',['','itemCode','$event',[]]]]]]}}" value="{{itemCode}}" bindinput="__e"/></view><view class="form-item"><text class="form-label">尺码</text><picker value="{{sizeIndex}}" range="{{sizes}}" data-event-opts="{{[['change',[['onSizeChange',['$event']]]]]}}" bindchange="__e"><view class="picker-value">{{sizes[sizeIndex]||'请选择'}}</view></picker></view><view class="form-item"><text class="form-label">退件原因</text><picker value="{{reasonIndex}}" range="{{reasons}}" data-event-opts="{{[['change',[['onReasonChange',['$event']]]]]}}" bindchange="__e"><view class="picker-value">{{reasons[reasonIndex]||'请选择'}}</view></picker></view><view class="form-item"><text class="form-label">备注</text><input class="form-input" placeholder="选填" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" value="{{remark}}" bindinput="__e"/></view><button class="btn-primary btn-yellow" loading="{{submitting}}" data-event-opts="{{[['tap',[['handleSubmit',['$event']]]]]}}" bindtap="__e">提交退件登记</button></view></block></view><block wx:if="{{$root.g0>0}}"><view class="section-title">最近退件记录</view></block><block wx:if="{{$root.g1>0}}"><view class="card"><block wx:for="{{returnList}}" wx:for-item="item" wx:for-index="idx" wx:key="idx"><view class="return-item"><view class="flex-between"><view><text class="return-express">{{item.express_no}}</text><text class="return-info">{{item.item_code+" / "+item.size+"码 - "+item.return_reason}}</text></view><view class="{{[item.status==='pending'?'tag-pending':'tag-done']}}">{{item.status==='pending'?'待处理':'已处理'}}</view></view></view></block></view></block></view>