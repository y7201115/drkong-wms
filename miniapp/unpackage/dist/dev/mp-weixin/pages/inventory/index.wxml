<view class="container"><view class="search-bar"><input class="search-input" placeholder="搜索货号" confirm-type="search" data-event-opts="{{[['confirm',[['handleSearch',['$event']]]],['input',[['__set_model',['','keyword','$event',[]]]]]]}}" value="{{keyword}}" bindconfirm="__e" bindinput="__e"/><button data-event-opts="{{[['tap',[['handleSearch',['$event']]]]]}}" class="search-btn" bindtap="__e">搜索</button></view><block wx:if="{{totalStock>0}}"><view class="stats-bar"><text class="stats-text">{{"共 "+$root.g0+" 个货号，总库存 "+totalStock+" 件"}}</text></view></block><block wx:if="{{loading}}"><view class="loading-area"><text class="text-secondary">加载中...</text></view></block><block wx:else><block wx:if="{{$root.g1===0}}"><view class="empty-area"><text class="text-secondary">暂无库存数据</text></view></block><block wx:else><view><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i0__" wx:key="item_code"><view class="card inventory-card"><view class="item-header flex-between"><text class="item-code">{{item.$orig.item_code}}</text><text class="item-total">{{"合计: "+item.m0+" 件"}}</text></view><view class="size-grid"><block wx:for="{{item.$orig.sizes}}" wx:for-item="s" wx:for-index="__i1__" wx:key="size"><view class="{{['size-item',s.quantity<5?'low-stock':'']}}"><text class="size-num">{{s.size}}</text><text class="{{['size-qty',s.quantity<5?'text-danger':'']}}">{{s.quantity}}</text></view></block></view></view></block></view></block></block><block wx:if="{{hasMore&&!loading}}"><view data-event-opts="{{[['tap',[['loadMore',['$event']]]]]}}" class="load-more" bindtap="__e"><text class="text-secondary">加载更多</text></view></block></view>