<view class="container"><view class="welcome-card card"><view class="flex-between"><view><text class="welcome-text">{{"你好，"+displayName}}</text><text class="welcome-sub">欢迎使用江博士仓库管理系统</text></view><view data-event-opts="{{[['tap',[['handleLogout',['$event']]]]]}}" class="avatar-area" bindtap="__e"><text class="avatar-text">{{displayName[0]}}</text></view></view></view><view class="stats-grid"><view data-event-opts="{{[['tap',[['goInventory',['$event']]]]]}}" class="stat-card" bindtap="__e"><text class="stat-num text-primary">{{stats.totalInventory||0}}</text><text class="stat-label">库存总量</text></view><view data-event-opts="{{[['tap',[['goInbound',['$event']]]]]}}" class="stat-card" bindtap="__e"><text class="stat-num text-success">{{stats.todayInbound||0}}</text><text class="stat-label">今日入库</text></view><view data-event-opts="{{[['tap',[['goOutbound',['$event']]]]]}}" class="stat-card" bindtap="__e"><text class="stat-num text-warning">{{stats.todayOutbound||0}}</text><text class="stat-label">今日出库</text></view><view data-event-opts="{{[['tap',[['goReturns',['$event']]]]]}}" class="stat-card" bindtap="__e"><text class="stat-num text-danger">{{stats.pendingReturns||0}}</text><text class="stat-label">待处理退件</text></view></view><view class="section-title">快捷操作</view><view class="quick-actions"><view data-event-opts="{{[['tap',[['goInbound',['$event']]]]]}}" class="action-item" bindtap="__e"><view class="action-icon action-icon-blue"><text class="icon-char">入</text></view><text class="action-text">扫码入库</text></view><view data-event-opts="{{[['tap',[['goOutbound',['$event']]]]]}}" class="action-item" bindtap="__e"><view class="action-icon action-icon-green"><text class="icon-char icon-green">出</text></view><text class="action-text">扫码出库</text></view><view data-event-opts="{{[['tap',[['goInventory',['$event']]]]]}}" class="action-item" bindtap="__e"><view class="action-icon action-icon-orange"><text class="icon-char icon-orange">查</text></view><text class="action-text">库存查询</text></view><view data-event-opts="{{[['tap',[['goReturns',['$event']]]]]}}" class="action-item" bindtap="__e"><view class="action-icon action-icon-red"><text class="icon-char icon-red">退</text></view><text class="action-text">退件处理</text></view></view><view class="section-title">最近操作</view><block wx:if="{{$root.g0>0}}"><view class="card"><block wx:for="{{recentRecords}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view class="record-item"><view class="flex-between"><view><text class="record-barcode">{{item.barcode}}</text><text class="record-info">{{item.item_code+" / "+item.size+"码 x "+item.quantity}}</text></view><view class="{{['record-tag',item.type==='inbound'?'tag-blue':'tag-green']}}">{{''+(item.type==='inbound'?'入库':'出库')+''}}</view></view></view></block></view></block><block wx:else><view class="card empty-card"><text class="text-secondary">暂无操作记录</text></view></block></view>